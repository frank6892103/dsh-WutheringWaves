{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/themes/theme-registry.schema.json",
  "title": "DSH Wuthering Waves theme registry",
  "type": "object",
  "required": ["schemaVersion", "themes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "package", "path", "bodyAttr", "order", "enabledByDefault"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "package": { "type": "string" },
          "path": { "type": "string" },
          "bodyAttr": { "type": "string", "pattern": "^data-" },
          "order": { "type": "integer" },
          "enabledByDefault": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
