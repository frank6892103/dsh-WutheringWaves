{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dsh/themes/theme-registry.schema.json",
  "title": "DSH Wuthering Waves theme registry",
  "type": "object",
  "required": ["schemaVersion", "selector", "themes"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "selector": {
      "type": "object",
      "required": ["officialThemeId", "storageKey", "persistence", "globalApi", "activation", "performanceStorageKey", "positionStorageKey", "defaultPerformance", "performanceModes", "previewLoading"],
      "properties": {
        "officialThemeId": { "const": "official" },
        "storageKey": { "type": "string", "minLength": 1 },
        "persistence": { "const": "local-storage-with-cookie-fallback" },
        "globalApi": { "type": "string", "pattern": "^__[A-Z0-9_]+__$" },
        "activation": { "const": "exclusive" },
        "performanceStorageKey": { "type": "string", "minLength": 1 },
        "positionStorageKey": { "type": "string", "minLength": 1 },
        "defaultPerformance": { "const": "economy" },
        "performanceModes": {
          "type": "array",
          "prefixItems": [{ "const": "economy" }, { "const": "full" }],
          "minItems": 2,
          "maxItems": 2
        },
        "previewLoading": { "const": "on-selector-open" }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "package", "path", "bodyAttr", "order", "enabledByDefault"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "package": { "type": "string" },
          "path": { "type": "string" },
          "bodyAttr": { "type": "string", "pattern": "^data-" },
          "order": { "type": "integer" },
          "enabledByDefault": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
