{
  "name": "dsh-wutheringwaves",
  "version": "0.4.0",
  "private": true,
  "description": "Switchable Wuthering Waves themes for DeepSeek Harness Web",
  "scripts": {
    "web": "dsh web",
    "theme:aemeath:build": "node themes/aemeath/scripts/build-client.mjs",
    "theme:aemeath:test": "node themes/aemeath/scripts/verify.mjs",
    "theme:aemeath:release": "node themes/aemeath/scripts/release.mjs",
    "theme:cantarella:build": "node themes/cantarella/scripts/build-client.mjs",
    "theme:cantarella:test": "node themes/cantarella/scripts/verify.mjs",
    "theme:cantarella:release": "node themes/cantarella/scripts/release.mjs",
    "theme:xinyuehu:build": "node themes/xinyuehu/scripts/build-client.mjs",
    "theme:xinyuehu:test": "node themes/xinyuehu/scripts/verify.mjs",
    "theme:xinyuehu:release": "node themes/xinyuehu/scripts/release.mjs",
    "theme:qingxiao:build": "node themes/qingxiao/scripts/build-client.mjs",
    "theme:qingxiao:test": "node themes/qingxiao/scripts/verify.mjs",
    "theme:qingxiao:release": "node themes/qingxiao/scripts/release.mjs",
    "theme:zhangbeihai:build": "node themes/zhangbeihai/scripts/build-client.mjs",
    "theme:zhangbeihai:test": "node themes/zhangbeihai/scripts/verify.mjs",
    "theme:zhangbeihai:release": "node themes/zhangbeihai/scripts/release.mjs",
    "theme:ronova:build": "node themes/ronova/scripts/build-client.mjs",
    "theme:ronova:test": "node themes/ronova/scripts/verify.mjs",
    "theme:ronova:release": "node themes/ronova/scripts/release.mjs",
    "themes:build": "pnpm run theme:aemeath:build && pnpm run theme:cantarella:build && pnpm run theme:xinyuehu:build && pnpm run theme:qingxiao:build && pnpm run theme:zhangbeihai:build && pnpm run theme:ronova:build",
    "themes:test": "node scripts/verify-registry.mjs && node scripts/verify-theme-hub.mjs && pnpm run theme:aemeath:test && pnpm run theme:cantarella:test && pnpm run theme:xinyuehu:test && pnpm run theme:qingxiao:test && pnpm run theme:zhangbeihai:test && pnpm run theme:ronova:test",
    "themes:release": "node scripts/release-themes.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  }
}
