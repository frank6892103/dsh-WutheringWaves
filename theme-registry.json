{
  "$schema": "./theme-registry.schema.json",
  "schemaVersion": 3,
  "selector": {
    "officialThemeId": "official",
    "storageKey": "dsh.wuthering-waves.active-theme.v1",
    "persistence": "local-storage-with-cookie-fallback",
    "globalApi": "__DSH_WUTHERING_THEME_HUB__",
    "activation": "exclusive",
    "performanceStorageKey": "dsh.wuthering-waves.performance.v1",
    "defaultPerformance": "economy",
    "performanceModes": ["economy", "full"],
    "previewLoading": "on-selector-open"
  },
  "themes": [
    {
      "id": "wuthering-aemeath",
      "name": "鸣潮 · 爱弥斯",
      "package": "@dsh-external/dsh-client-ui-skin-wuthering-aemeath",
      "path": "themes/aemeath",
      "bodyAttr": "data-dsh-skin-aemeath",
      "order": 10,
      "enabledByDefault": false
    },
    {
      "id": "wuthering-cantarella",
      "name": "鸣潮 · 坎特蕾拉",
      "package": "@dsh-external/dsh-client-ui-skin-wuthering-cantarella",
      "path": "themes/cantarella",
      "bodyAttr": "data-dsh-skin-cantarella",
      "order": 20,
      "enabledByDefault": false
    }
  ]
}
