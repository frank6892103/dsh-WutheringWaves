{
  "name": "@dsh-external/dsh-client-ui-skin-genshin-ronova",
  "version": "0.2.2",
  "private": true,
  "description": "A switchable Ronova theme for DeepSeek Harness Web GUI",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-skin",
    "genshin-impact",
    "ronova"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/verify.mjs",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "assets/ronova-character.png",
    "assets/ronova-sanctuary.webp",
    "assets/source.json",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "LICENSE-CODE",
    "NOTICE",
    "preview",
    "README.md",
    "skin.json"
  ]
}

